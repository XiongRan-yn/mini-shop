<!-- 商品卡片 - CDN占位图，无需网络资源 -->
<view class="goods-card" bindtap="onClick">
  <!-- 商品图片 -->
  <view class="goods-image-wrap">
    <image
      class="goods-image"
      src="{{image}}"
      mode="aspectFill"
      binderror="onImageError"
      wx:if="{{!imageError}}"
    />
    <view class="goods-image-placeholder" wx:if="{{imageError}}">
      <text class="placeholder-icon">📦</text>
    </view>
  </view>
  <!-- 商品信息 -->
  <view class="goods-info">
    <view class="goods-name text-ellipsis">{{goods.name}}</view>
    <view class="goods-bottom">
      <view class="goods-price-wrap">
        <text class="goods-price">¥{{goods.price}}</text>
        <text class="goods-original-price" wx:if="{{goods.originalPrice > goods.price}}">¥{{goods.originalPrice}}</text>
      </view>
      <view class="goods-sales">已售{{goods.sales}}</view>
    </view>
  </view>
</view>