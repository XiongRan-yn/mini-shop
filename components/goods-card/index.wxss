/* 商品卡片组件样式 */
.goods-card {
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.goods-image-wrap {
  width: 100%;
  height: 320rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.goods-image {
  width: 100%;
  height: 100%;
  display: block;
}

.goods-image-placeholder {
  font-size: 80rpx;
  color: #cccccc;
}

.goods-info {
  padding: 16rpx 20rpx 20rpx;
}

.goods-name {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.4;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.goods-price-wrap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.goods-price {
  color: #ff4757;
  font-size: 32rpx;
  font-weight: bold;
}

.goods-original-price {
  color: #999999;
  font-size: 22rpx;
  text-decoration: line-through;
}

.goods-sales {
  color: #999999;
  font-size: 22rpx;
}