<!-- 订单列表页 -->
<view class="page">
  <!-- 状态Tab栏 -->
  <scroll-view scroll-x class="tab-bar" wx:if="{{orderList.length > 0}}">
    <view
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onTabTap"
    >{{item.label}}</view>
  </scroll-view>

  <!-- 订单列表 -->
  <view wx:if="{{filteredList.length > 0}}">
    <view class="order-card card" wx:for="{{filteredList}}" wx:key="orderNo">
      <!-- 订单头部 -->
      <view class="order-header flex-between" bindtap="onOrderTap" data-order-no="{{item.orderNo}}">
        <text class="order-no">订单号：{{item.orderNo}}</text>
        <text class="order-status" style="color: {{item.status === 'pending_payment' ? '#ff5777' : item.status === 'completed' ? '#999' : '#4ecdc4'}}">
          {{item.status === 'pending_payment' ? '待付款' : item.status === 'pending_shipment' ? '待发货' : item.status === 'pending_receipt' ? '待收货' : item.status === 'completed' ? '已完成' : item.status === 'cancelled' ? '已取消' : item.status}}
        </text>
      </view>

      <!-- 商品列表（动态生成图片） -->
      <view class="order-goods" bindtap="onOrderTap" data-order-no="{{item.orderNo}}">
        <view class="goods-row" wx:for="{{item.items}}" wx:key="id" wx:for-item="goods">
          <image class="goods-thumb" src="{{goods.image || ''}}" mode="aspectFill" />
          <view class="goods-info">
            <view class="goods-name text-ellipsis">{{goods.name}}</view>
            <view class="goods-price-wrap">
              <text class="goods-price">¥{{goods.price}}</text>
              <text class="goods-qty">×{{goods.quantity}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 合计 -->
      <view class="order-total" bindtap="onOrderTap" data-order-no="{{item.orderNo}}">
        <text>共{{item.items.length}}件 合计：</text>
        <text class="total-price">¥{{item.totalPrice}}</text>
        <text wx:if="{{item.freight > 0}}">（含运费¥{{item.freight}}）</text>
      </view>

      <!-- 操作按钮 -->
      <view class="order-actions">
        <view class="action-btn outline" wx:if="{{item.status === 'pending_payment'}}" bindtap="onCancel" data-order-no="{{item.orderNo}}">取消订单</view>
        <view class="action-btn primary" wx:if="{{item.status === 'pending_payment'}}" bindtap="onPay" data-order-no="{{item.orderNo}}">去支付</view>
        <view class="action-btn primary" wx:if="{{item.status === 'pending_receipt'}}" bindtap="onConfirmReceive" data-order-no="{{item.orderNo}}">确认收货</view>
        <view class="action-btn outline" bindtap="onOrderTap" data-order-no="{{item.orderNo}}">查看详情</view>
      </view>
    </view>
    <view style="height: 40rpx;"></view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无订单</text>
    <text class="empty-sub">快去挑选心仪的商品吧~</text>
  </view>
</view>
