/* 分类页样式 */
.page {
  height: 100vh;
  overflow: hidden;
}

/* ========== 左侧分类栏 ========== */
.left-sidebar {
  width: 180rpx;
  background: #f8f8f8;
  height: 100%;
}
.sidebar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 10rpx;
  position: relative;
}
.sidebar-item.active {
  background: #ffffff;
}
.sidebar-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20rpx;
  bottom: 20rpx;
  width: 6rpx;
  background: #ff5777;
  border-radius: 0 3rpx 3rpx 0;
}
.sidebar-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}
.sidebar-name {
  font-size: 24rpx;
  color: #666666;
}
.sidebar-item.active .sidebar-name {
  color: #ff5777;
  font-weight: 500;
}

/* ========== 右侧商品列表 ========== */
.right-content {
  flex: 1;
  height: 100%;
  padding: 16rpx;
}
.product-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.product-item {
  width: calc(50% - 8rpx);
}
