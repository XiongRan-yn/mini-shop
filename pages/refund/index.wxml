<view class="page">
  <view class="card price-card">
    <text class="price-label">退款金额</text>
    <text class="price-value">楼{{totalPrice}}</text>
  </view>

  <view class="card reason-section">
    <view class="section-title">选择退款原因</view>
    <view class="reason-list">
      <view class="reason-item {{reason === item ? 'active' : ''}}" wx:for="{{reasons}}" wx:key="*this" data-text="{{item}}" bindtap="onReasonTap">{{item}}</view>
    </view>
  </view>

  <view class="submit-wrap">
    <view class="btn-primary" bindtap="onSubmit">提交退款申请</view>
  </view>
</view>
