.price-card { display:flex; align-items:center; justify-content:space-between; padding:30rpx; margin-bottom:20rpx; }
.price-label { font-size:30rpx; color:var(--text-secondary); }
.price-value { font-size:44rpx; font-weight:bold; color:var(--price-color); }
.reason-section { padding:24rpx 30rpx; margin-bottom:20rpx; }
.section-title { font-size:30rpx; font-weight:500; margin-bottom:20rpx; }
.reason-list { display:flex; flex-wrap:wrap; gap:16rpx; }
.reason-item { padding:16rpx 28rpx; background:var(--bg); border-radius:30rpx; font-size:26rpx; color:var(--text-secondary); border:2rpx solid transparent; }
.reason-item.active { background:var(--primary-light); color:var(--primary); border-color:var(--primary); }
.submit-wrap { padding:30rpx; margin-top:40rpx; }
