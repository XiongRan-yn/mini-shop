<!-- 结算页 -->
<view class="page">
  <!-- 收货地址 -->
  <view class="address-card card" bindtap="onSelectAddress">
    <view wx:if="{{address}}" class="address-info">
      <view class="address-header flex-between">
        <text class="addr-name">{{address.name}}</text>
        <text class="addr-phone">{{address.phone}}</text>
      </view>
      <view class="addr-detail">
        <text class="addr-tag" wx:if="{{address.isDefault}}">默认</text>
        <text>{{address.region}} {{address.detail}}</text>
      </view>
    </view>
    <view wx:else class="address-empty flex-center">
      <text>📫 请添加收货地址</text>
      <text class="addr-arrow">›</text>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="goods-section card">
    <view class="section-title">商品信息</view>
    <view class="goods-item" wx:for="{{items}}" wx:key="id">
      <image class="goods-thumb" src="{{item.image}}" mode="aspectFill" />
      <view class="goods-info">
        <view class="goods-name text-ellipsis">{{item.name}}</view>
        <view class="goods-price-wrap">
          <text class="goods-price">¥{{item.price}}</text>
          <text class="goods-qty">×{{item.quantity}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="remark-section card">
    <text class="remark-label">备注</text>
    <input
      class="remark-input"
      placeholder="选填：如有特殊要求请备注"
      value="{{remark}}"
      bindinput="onRemarkInput"
    />
  </view>

  <!-- 费用明细 -->
  <view class="price-section card">
    <view class="price-row">
      <text>商品总额</text>
      <text>¥{{totalPrice}}</text>
    </view>
    <view class="price-row">
      <text>运费</text>
      <text>{{freight > 0 ? '¥' + freight : '免运费'}}</text>
    </view>
    <view class="price-row total">
      <text>应付总额</text>
      <text class="total-price">¥{{totalPrice + freight}}</text>
    </view>
  </view>

  <!-- 底部占位 -->
  <view style="height: 140rpx;"></view>

  <!-- 底部提交栏 -->
  <view class="bottom-bar">
    <view class="total-wrap">
      <text>应付：</text>
      <text class="total-price">¥{{totalPrice + freight}}</text>
    </view>
    <view class="submit-btn" bindtap="onSubmit">提交订单</view>
  </view>
</view>
