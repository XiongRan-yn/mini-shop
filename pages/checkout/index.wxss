/* 结算页样式 */

/* ========== 地址卡片 ========== */
.address-card {
  margin: 20rpx;
  padding: 30rpx;
  background: #fff8f0;
}
.address-header {
  margin-bottom: 12rpx;
}
.addr-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.addr-phone {
  font-size: 28rpx;
  color: #666;
}
.addr-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}
.addr-tag {
  display: inline-block;
  background: #ff5777;
  color: #fff;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}
.address-empty {
  font-size: 28rpx;
  color: #999;
}
.addr-arrow {
  font-size: 40rpx;
  margin-left: 12rpx;
  color: #ccc;
}

/* ========== 商品区域 ========== */
.goods-section {
  margin: 0 20rpx 20rpx;
  padding: 20rpx 30rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.goods-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.goods-item:last-child {
  border-bottom: none;
}
.goods-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.goods-info {
  flex: 1;
  overflow: hidden;
}
.goods-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 12rpx;
}
.goods-price-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.goods-price {
  font-size: 28rpx;
  color: #ff4757;
  font-weight: bold;
}
.goods-qty {
  font-size: 24rpx;
  color: #999;
}

/* ========== 备注 ========== */
.remark-section {
  margin: 0 20rpx 20rpx;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.remark-label {
  font-size: 28rpx;
  color: #333;
  white-space: nowrap;
}
.remark-input {
  flex: 1;
  font-size: 26rpx;
}

/* ========== 费用明细 ========== */
.price-section {
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
}
.price-row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}
.price-row:last-child {
  margin-bottom: 0;
}
.price-row.total {
  font-weight: bold;
  color: #333;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}
.total-price {
  color: #ff4757;
  font-size: 32rpx;
  font-weight: bold;
}

/* ========== 底部提交栏 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 20rpx;
  border-top: 1rpx solid #eeeeee;
  gap: 20rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
.total-wrap {
  font-size: 28rpx;
  color: #333;
}
.submit-btn {
  background: #ff5777;
  color: #ffffff;
  font-size: 30rpx;
  padding: 18rpx 48rpx;
  border-radius: 36rpx;
}
