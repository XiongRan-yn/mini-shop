/* 我的收藏页样式 */
.page {
  padding: 20rpx;
}

.favorite-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.favorite-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  gap: 20rpx;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.item-name {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.4;
}

.item-bottom {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.item-price {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.price-current {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff4757;
}

.price-original {
  font-size: 22rpx;
  color: #999999;
  text-decoration: line-through;
}

.item-sales {
  font-size: 22rpx;
  color: #999999;
}

.item-remove {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #ff5777;
  flex-shrink: 0;
}