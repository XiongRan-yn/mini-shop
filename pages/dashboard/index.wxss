.page {
  background-color: #f5f5f5;
  padding: 24rpx;
}
.stat-wrap {
  display: flex;
  gap: 16rpx;
  margin-bottom: 40rpx;
}
.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding:32rpx 12rpx;
  text-align: center;
}
.stat-label {
  font-size:24rpx;
  color:#666;
  display:block;
  margin-bottom:10rpx;
}
.stat-value {
  font-size:32rpx;
  font-weight:bold;
  color:#ff5777;
}
.block-title {
  font-size:30rpx;
  font-weight:500;
  margin-bottom:20rpx;
}
.order-card {
  background:#fff;
  border-radius:12rpx;
  padding:28rpx;
  margin-bottom:16rpx;
}
.order-line {
  display:flex;
  justify-content:space-between;
  font-size:26rpx;
  color:#333;
  margin-bottom:10rpx;
}
.empty {
  text-align:center;
  font-size:26rpx;
  color:#999;
  margin-top:80rpx;
}