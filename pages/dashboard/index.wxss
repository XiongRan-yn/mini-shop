.page {
  padding: 20rpx;
  background-color: #f5f7fa;
}

.card-wrap {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.stat-card {
  flex:1;
  background: #fff;
  border-radius: 16rpx;
  padding:30rpx 10rpx;
  text-align:center;
}

.stat-label {
  font-size:24rpx;
  color:#666;
  display:block;
  margin-bottom:12rpx;
}
.stat-value {
  font-size:32rpx;
  color:#333;
  font-weight:bold;
}

.list-card {
  background:#fff;
  border-radius:16rpx;
  padding:30rpx;
}
.list-title {
  font-size:30rpx;
  font-weight:bold;
  margin-bottom:24rpx;
}

.order-item {
  border-bottom:1rpx solid #eee;
  padding:24rpx 0;
}
.order-item:last-child{
  border-bottom:none;
}

.row {
  display:flex;
  justify-content:space-between;
  margin:8rpx 0;
}
.order-no,.time {
  font-size:26rpx;
  color:#555;
}
.money {
  font-size:28rpx;
  color:#f56c6c;
}
.status {
  font-size:26rpx;
  color:#07c160;
}

.empty-tip {
  text-align:center;
  color:#999;
  padding:60rpx 0;
  font-size:26rpx;
}
