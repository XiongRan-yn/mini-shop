.page{
  padding:20rpx;
  background:#f5f5f5;
}
.card-wrap{
  display:flex;
  gap:20rpx;
  margin-bottom:30rpx;
}
.stat-card{
  flex:1;
  background:#fff;
  border-radius:16rpx;
  text-align:center;
  padding:30rpx 10rpx;
}
.stat-label{
  font-size:24rpx;
  color:#888;
  display:block;
  margin-bottom:12rpx;
}
.stat-value{
  font-size:34rpx;
  font-weight:bold;
  color:#ff5777;
}

.list-card{
  background:#fff;
  border-radius:16rpx;
  padding:30rpx;
}
.list-title{
  font-size:30rpx;
  font-weight:bold;
  margin-bottom:24rpx;
}
.order-item{
  padding:24rpx 0;
  border-bottom:1rpx solid #eee;
}
.order-item:last-child{
  border-bottom:none;
}
.row{
  display:flex;
  justify-content:space-between;
  margin-bottom:8rpx;
}
.order-no{
  font-size:24rpx;
  color:#666;
}
.money{
  font-size:26rpx;
  color:#ff5777;
}
.time{
  font-size:22rpx;
  color:#aaa;
}
.status{
  font-size:22rpx;
  color:#666;
}
.empty-tip{
  text-align:center;
  color:#999;
  padding:60rpx 0;
}
