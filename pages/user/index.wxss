/* 个人中心页样式 */

/* ========== 用户头部 ========== */
.user-header {
  background: linear-gradient(135deg, #ff5777, #ff8a80);
  padding: 60rpx 30rpx 40rpx;
  position: relative;
}
.user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  background: rgba(255, 255, 255, 0.3);
}
.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}
.user-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
}
.user-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}
.login-btn {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}
.logout-btn {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
}

/* ========== 订单概览 ========== */
.order-section {
  margin: -20rpx 20rpx 20rpx;
  padding: 24rpx 20rpx 20rpx;
}
.section-header {
  padding: 0 10rpx 20rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.section-more {
  font-size: 24rpx;
  color: #999;
}
.order-grid {
  display: flex;
  justify-content: space-around;
}
.order-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  position: relative;
  padding: 10rpx 20rpx;
}
.order-icon {
  font-size: 44rpx;
}
.order-label {
  font-size: 24rpx;
  color: #666;
}
.order-badge {
  position: absolute;
  top: 0;
  right: 8rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background: #ff4757;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  padding: 0 8rpx;
}

/* ========== 功能菜单 ========== */
.menu-section {
  margin: 20rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  gap: 20rpx;
}
.menu-icon {
  font-size: 36rpx;
}
.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
}
