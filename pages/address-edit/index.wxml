<!-- 地址编辑页 -->
<view class="page">
  <view class="form-card card">
    <!-- 收货人 -->
    <view class="form-item">
      <text class="form-label">收货人</text>
      <input
        class="form-input"
        placeholder="请输入收货人姓名"
        value="{{form.name}}"
        data-field="name"
        bindinput="onInput"
      />
    </view>

    <!-- 手机号 -->
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input
        class="form-input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号码"
        value="{{form.phone}}"
        data-field="phone"
        bindinput="onInput"
      />
    </view>

    <!-- 所在地区 -->
    <view class="form-item">
      <text class="form-label">所在地区</text>
      <picker mode="region" value="{{regionIndex}}" bindchange="onRegionChange">
        <view class="form-picker {{form.region ? '' : 'placeholder'}}">
          {{form.region || '请选择省/市/区'}}
        </view>
      </picker>
    </view>

    <!-- 详细地址 -->
    <view class="form-item">
      <text class="form-label">详细地址</text>
      <input
        class="form-input"
        placeholder="街道、门牌号等"
        value="{{form.detail}}"
        data-field="detail"
        bindinput="onInput"
      />
    </view>

    <!-- 设为默认地址 -->
    <view class="form-item">
      <text class="form-label">默认地址</text>
      <switch checked="{{form.isDefault}}" bindchange="onToggleDefault" color="#ff5777" />
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-section">
    <view class="save-btn btn-primary" bindtap="onSave">保存地址</view>
  </view>
</view>
