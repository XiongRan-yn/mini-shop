<!-- 订单详情页 -->
<view class="page" wx:if="{{order}}">
  <!-- 订单状态横幅 -->
  <view class="status-banner" style="background: {{statusColor}};">
    <text class="status-text">{{statusText}}</text>
    <text class="status-desc" wx:if="{{order.status === 'pending_payment'}}">请尽快完成支付</text>
    <text class="status-desc" wx:elif="{{order.status === 'pending_shipment'}}">商家正在准备您的商品</text>
    <text class="status-desc" wx:elif="{{order.status === 'pending_receipt'}}">您的包裹正在路上</text>
    <text class="status-desc" wx:elif="{{order.status === 'completed'}}">交易已完成</text>
    <text class="status-desc" wx:elif="{{order.status === 'cancelled'}}">订单已取消</text>
    <text class="status-desc" wx:elif="{{order.status === 'after_sale'}}">售后处理中</text>
  </view>

  <!-- 收货地址 -->
  <view class="info-card card" wx:if="{{order.address}}">
    <view class="card-title">📫 收货信息</view>
    <view class="info-row">
      <text>{{order.address.name}} {{order.address.phone}}</text>
    </view>
    <view class="info-row">
      <text>{{order.address.region}} {{order.address.detail}}</text>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="info-card card">
    <view class="card-title">📦 商品信息</view>
    <view class="goods-item" wx:for="{{order.items}}" wx:key="id" wx:for-item="goods">
      <image class="goods-thumb" src="{{goods.image || ''}}" mode="aspectFill" />
      <view class="goods-info">
        <view class="goods-name text-ellipsis">{{goods.name}}</view>
        <view class="goods-price-row">
          <text class="goods-price">¥{{goods.price}}</text>
          <text class="goods-qty">×{{goods.quantity}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="info-card card">
    <view class="card-title">📋 订单信息</view>
    <view class="info-row">
      <text class="info-label">订单编号</text>
      <text class="info-value">{{order.orderNo}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">创建时间</text>
      <text class="info-value">{{order.createTime}}</text>
    </view>
    <view class="info-row" wx:if="{{order.remark}}">
      <text class="info-label">备注</text>
      <text class="info-value">{{order.remark}}</text>
    </view>
  </view>

  <!-- 费用明细 -->
  <view class="info-card card">
    <view class="card-title">💰 费用明细</view>
    <view class="info-row">
      <text class="info-label">商品总额</text>
      <text class="info-value">¥{{order.totalPrice - order.freight}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">运费</text>
      <text class="info-value">{{order.freight > 0 ? '¥' + order.freight : '免运费'}}</text>
    </view>
    <view class="info-row total">
      <text class="info-label">实付金额</text>
      <text class="info-value total-price">¥{{order.totalPrice}}</text>
    </view>
  </view>

  <!-- 底部占位 -->
  <view style="height: 140rpx;"></view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar" wx:if="{{order.status === 'pending_payment' || order.status === 'pending_receipt' || order.status === 'completed'}}">
    <view class="action-btn outline" wx:if="{{order.status === 'pending_payment'}}" bindtap="onCancel">取消订单</view>
    <view class="action-btn primary" wx:if="{{order.status === 'pending_payment'}}" bindtap="onPay">去支付</view>
    <view class="action-btn primary" wx:if="{{order.status === 'pending_receipt'}}" bindtap="onConfirmReceive">确认收货</view>
    <view class="action-btn outline" wx:if="{{order.status === 'completed' && !hasRefund}}" bindtap="onRefund">申请退款</view>
    <view class="action-btn disabled" wx:elif="{{order.status === 'completed' && hasRefund}}">已申请退款</view>
  </view>
</view>

<!-- 订单不存在 -->
<view class="empty-state" wx:else>
  <text class="empty-icon">😕</text>
  <text class="empty-text">订单不存在</text>
</view>
