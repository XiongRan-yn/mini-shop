/* 商品详情页样式 */

/* ========== 商品图片轮播 ========== */
.goods-swiper {
  width: 100%;
  height: 750rpx;
}
.goods-image {
  width: 100%;
  height: 100%;
}

/* ========== 商品信息卡片 ========== */
.goods-info {
  margin: 20rpx;
  padding: 30rpx;
}
.price-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.price-current {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff4757;
}
.price-original {
  font-size: 28rpx;
  color: #999999;
  text-decoration: line-through;
}
.goods-name {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
  line-height: 1.5;
  margin-bottom: 16rpx;
}
.goods-meta {
  display: flex;
  gap: 32rpx;
}
.meta-item {
  font-size: 24rpx;
  color: #999999;
}

/* ========== 规格卡片 ========== */
.specs-card {
  margin: 0 20rpx 20rpx;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.specs-label {
  font-size: 26rpx;
  color: #999999;
  white-space: nowrap;
}
.specs-value {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.6;
}

/* ========== 描述卡片 ========== */
.desc-card {
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
}
.desc-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eeeeee;
}
.desc-content {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
}

/* ========== 底部操作栏 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  border-top: 1rpx solid #eeeeee;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 200;
}
.quantity-ctrl {
  display: flex;
  align-items: center;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  margin-right: 20rpx;
}
.qty-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #333;
  background: #f8f8f8;
}
.qty-btn:active {
  background: #e0e0e0;
}
.qty-num {
  width: 72rpx;
  text-align: center;
  font-size: 30rpx;
  color: #333;
}
.bar-actions {
  flex: 1;
  display: flex;
  gap: 16rpx;
}
.btn-cart {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border: 2rpx solid #ff5777;
  color: #ff5777;
  border-radius: 36rpx;
  font-size: 28rpx;
}
.btn-buy {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #ff5777;
  color: #ffffff;
  border-radius: 36rpx;
  font-size: 28rpx;
}

/* ========== 购物车提示条 ========== */
.cart-tip {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: #ff5777;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  z-index: 300;
}
